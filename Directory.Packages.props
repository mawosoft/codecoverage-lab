<Project>

  <ItemGroup>
    <!-- Microsoft.NET.Test.Sdk has a dependency on Microsoft.CodeCoverage.
         We cannot directly references a lower MSCC version ourselves. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Microsoft.Testing.Platform dependencies are transitive via xunit.v3.mtp-v2
         and other MTP packages. -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />

    <PackageVersion Include="Microsoft.CodeCoverage" Version="18.10.1" />
    <!-- Microsoft.CodeCoverage.MSBuild just runs dotnet-coverage inside MSBuild. -->
    <!-- <PackageVersion Include="Microsoft.CodeCoverage.MSBuild" Version="18.11.2" /> -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />

    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />

    <PackageVersion Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <!-- Pinned. coverlet and xunit reference different MTP versions. -->
  <ItemGroup>
<!--
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.4.1" />
-->
  </ItemGroup>

</Project>
